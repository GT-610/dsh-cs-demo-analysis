{
  "name": "dsh-cs2-demo-analysis",
  "version": "0.1.0",
  "description": "Counter-Strike 2 demo analysis mode for DeepSeek Harness: local parsing, round/economy/player statistics, map awareness, and post-match review tools.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "dist",
    "skills",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.en-US.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "check": "tsc --noEmit && node --test && tsdown",
    "prepare": "tsdown"
  },
  "dependencies": {
    "@laihoe/demoparser2": "0.42.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "counter-strike",
    "cs2",
    "demo",
    "replay",
    "analysis"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GT-610/dsh-cs-demo-analysis.git"
  },
  "homepage": "https://github.com/GT-610/dsh-cs-demo-analysis#readme",
  "bugs": {
    "url": "https://github.com/GT-610/dsh-cs-demo-analysis/issues"
  }
}
